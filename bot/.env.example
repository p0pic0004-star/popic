# Copy this file to `.env` and fill in the values. Never commit `.env`.

# From @BotFather in Telegram: /newbot, then paste the token here.
BOT_TOKEN=

# Your visit card's public HTTPS URL (the Vercel one).
# Telegram Mini Apps refuse http:// and localhost.
MINI_APP_URL=

# https://console.anthropic.com  — pays for the OCR.
ANTHROPIC_API_KEY=

# https://platform.openai.com  — pays for Whisper voice transcription.
OPENAI_API_KEY=
